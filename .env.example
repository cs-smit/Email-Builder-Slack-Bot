# Copy to .env and fill in. Never commit .env.

# --- Slack (see README → Slack app) ---
# Bot User OAuth Token (OAuth & Permissions), xoxb-...
SLACK_BOT_TOKEN=
# Only for running on your own machine/server (Socket Mode): App-Level Token with connections:write, xapp-...
SLACK_APP_TOKEN=

# --- Your template library: set ONE of these (see docs/template-library.md) ---
# A folder of existing .html email templates
LIBRARY_DIR=
# Or a website that publishes a manifest of them
LIBRARY_URL=
LIBRARY_MANIFEST=gallery/templates.js

# Who the emails are for (used in Claude's instructions)
BRAND_NAME=

# --- Figma (optional: only for Figma links; uploads work without it) ---
# Personal access token, scope "File content: Read-only", from an account with a Dev or Full seat
FIGMA_TOKEN=

# --- Claude ---
# On your own Mac, `claude login` is enough. On a server or in GitHub Actions, set one of:
# your Claude subscription (run `claude setup-token` and paste the token)
CLAUDE_CODE_OAUTH_TOKEN=
# or a pay-per-use API key from console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: a specific model; blank uses Claude Code's default
CLAUDE_MODEL=

# --- Optional tuning ---
# Compare-and-fix rounds after building (more = closer to the design, slower)
REVIEW_ROUNDS=1
FIGMA_SCALE=2
